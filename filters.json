{
  "$schema": "vendor/marinos/filter-panel.schema.json",
  "schemaVersion": "1.0.0",
  "search": {
    "id": "filter-search",
    "fields": [
      "eventName",
      "project",
      "partners",
      "agencies",
      "geographicAreas",
      "location"
    ],
    "match": "words"
  },
  "groups": [
    {
      "type": "date-range",
      "id": "date",
      "label": "Dates",
      "fromParam": "from",
      "toParam": "to",
      "field": "date"
    },
    {
      "type": "checkbox",
      "id": "audience",
      "label": "Audiences",
      "allLabel": "All audiences",
      "options": {
        "app": true
      },
      "field": "audience"
    },
    {
      "type": "checkbox",
      "id": "type",
      "label": "Types",
      "allLabel": "All types",
      "options": {
        "app": true
      },
      "field": "type"
    },
    {
      "type": "checkbox",
      "id": "project",
      "label": "Projects",
      "allLabel": "All projects",
      "options": {
        "app": true
      },
      "field": "project"
    },
    {
      "type": "checkbox",
      "id": "agency",
      "label": "Agencies",
      "allLabel": "All agencies",
      "options": {
        "app": true
      },
      "field": "agencies"
    },
    {
      "type": "checkbox",
      "id": "partner",
      "label": "Partners",
      "allLabel": "All partners",
      "options": {
        "app": true
      },
      "field": "partners"
    },
    {
      "type": "checkbox",
      "id": "status",
      "label": "Statuses",
      "allLabel": "All statuses",
      "options": {
        "app": true
      },
      "field": "status"
    },
    {
      "type": "checkbox",
      "id": "area",
      "label": "Places",
      "allLabel": "All places",
      "options": {
        "app": true
      },
      "field": "geographicAreas"
    },
    {
      "type": "checkbox",
      "id": "owner",
      "label": "Owners",
      "allLabel": "All owners",
      "options": {
        "app": true
      },
      "field": "owner"
    }
  ]
}
