{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engagements.schema.json",
  "title": "Marin Reach engagements dataset",
  "type": "object",
  "required": ["schemaVersion", "source", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/engagement" } }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "place": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["physical", "virtual"] },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "streetAddress": { "type": "string", "minLength": 1 },
            "locality": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 },
            "postalCode": { "type": "string", "minLength": 1 },
            "country": { "type": "string", "minLength": 1 }
          }
        },
        "geo": {
          "type": "object",
          "required": ["latitude", "longitude"],
          "additionalProperties": false,
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "engagement": {
      "type": "object",
      "required": ["id", "project", "date", "status", "agencies", "partners", "geographicAreas"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^eng-[0-9a-f]{10}(-[0-9]+)?$" },
        "project": { "type": "string", "minLength": 1 },
        "owner": { "type": ["string", "null"] },
        "agencies": { "$ref": "#/$defs/stringList" },
        "partners": { "$ref": "#/$defs/stringList" },
        "audience": { "type": ["string", "null"] },
        "eventName": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"] },
        "geographicAreas": { "$ref": "#/$defs/stringList" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "startTime": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "endTime": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "location": { "type": ["string", "null"] },
        "place": { "$ref": "#/$defs/place" },
        "status": { "enum": ["Planned", "Canceled", "Completed"] },
        "raw": {
          "type": "object",
          "description": "Source values for fields whose display value was changed by an alias.",
          "additionalProperties": { "$ref": "#/$defs/stringList" }
        }
      }
    }
  }
}
